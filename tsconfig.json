{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "allowJs": true,
    "paths": {
      "react": [
        "../akalin-ai-assistants/node_modules/@types/react"
      ],
      "react/*": [
        "../akalin-ai-assistants/node_modules/@types/react/*"
      ],
      "react-dom": [
        "../akalin-ai-assistants/node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "../akalin-ai-assistants/node_modules/@types/react-dom/*"
      ],
      "react-router-dom": [
        "../akalin-ai-assistants/node_modules/react-router-dom"
      ],
      "react-i18next": [
        "../akalin-ai-assistants/node_modules/react-i18next"
      ],
      "i18next": [
        "../akalin-ai-assistants/node_modules/i18next"
      ],
      "react-hot-toast": [
        "../akalin-ai-assistants/node_modules/react-hot-toast"
      ],
      "axios": [
        "../akalin-ai-assistants/node_modules/axios"
      ],
      "lucide-react": [
        "../akalin-ai-assistants/node_modules/lucide-react"
      ],
      "@akalin/ui": [
        "../akalin-ui/src/index.ts"
      ],
      "@akalin/ui/*": [
        "../akalin-ui/src/*"
      ],
      "@akalin/module_core": [
        "../akalin-module-core/src/index.ts"
      ],
      "@akalin/module_core/*": [
        "../akalin-module-core/src/*"
      ],
      "@akalin/ai-assistants": [
        "../akalin-ai-assistants/src/index.ts"
      ],
      "@akalin/ai-assistants/*": [
        "../akalin-ai-assistants/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}