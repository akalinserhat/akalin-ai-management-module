{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "allowJs": true,
    "paths": {
      "react": ["../webakus/Webakus.UI/node_modules/@types/react"],
      "react/*": ["../webakus/Webakus.UI/node_modules/@types/react/*"],
      "react-dom": ["../webakus/Webakus.UI/node_modules/@types/react-dom"],
      "react-dom/*": ["../webakus/Webakus.UI/node_modules/@types/react-dom/*"],
      "react-router-dom": ["../webakus/node_modules/react-router-dom"],
      "react-i18next": ["../webakus/node_modules/react-i18next"],
      "i18next": ["../webakus/node_modules/i18next"],
      "react-hot-toast": ["../webakus/node_modules/react-hot-toast"],
      "axios": ["../webakus/node_modules/axios"],
      "lucide-react": ["../webakus/node_modules/lucide-react"],
      "@akalin/ui": ["../webakus/node_modules/@akalin/ui/src/index.ts"],
      "@akalin/ui/*": ["../webakus/node_modules/@akalin/ui/src/*"],
      "@akalin/module_core": ["../webakus/node_modules/@akalin/module_core/src/index.ts"],
      "@akalin/module_core/*": ["../webakus/node_modules/@akalin/module_core/src/*"],
      "@akalin/ai-assistants": ["../akalin-ai-assistants/src/index.ts"],
      "@akalin/ai-assistants/*": ["../akalin-ai-assistants/src/*"]
    }
  },
  "include": ["src"]
}
